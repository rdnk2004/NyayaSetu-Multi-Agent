# Gemini API Key configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL=gemini-3.1-flash-lite   # defaults to this if unset - override if you hit quota limits on this model

# Cost & Token Control Settings
ENABLE_PROMPT_CACHE=true        # Cache identical prompts to save 100% tokens

# Safety Rate Limits (client-side pacing to respect Gemini Free Tier limits)
MAX_CALLS_PER_MINUTE=15         # Keep at <= 15 to stay within Google Free Tier (15 RPM)
MAX_CALLS_PER_SESSION=200       # Stop execution if >200 requests made in one run
API_TIMEOUT_SECONDS=15.0        # Timeout per HTTP request

# Retrieval & Search Tunables
QA_RETRIEVAL_TOP_K=5            # Statutory chunks retrieved for QA Agent
DEBATE_RETRIEVAL_TOP_K=8        # Statutory chunks retrieved for Debate Mechanism (higher to capture countervailing clauses)
LANDMARK_CASE_TOP_K=3           # Precedent cases retrieved for Landmark Case Agent

# Embedding & Vector Database Settings
EMBEDDING_MODEL=multi-qa-mpnet-base-dot-v1
CHROMA_DB_PATH=data/chroma_db
STATUTE_COLLECTION_NAME=legal_chunks
CASE_LAW_COLLECTION_NAME=case_law

# Intake & Chunking Settings
MAX_QUESTIONS=6                 # Maximum intake questions before completing intake
CHUNK_MAX_WORDS=350             # Maximum words per statutory chunk during parsing

INDIAN_KANOON_API_KEY = your_indian_kanoon_api_key_here

