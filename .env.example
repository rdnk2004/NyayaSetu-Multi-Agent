# Gemini API Key configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite

# Cost & Token Control Settings
MAX_OUTPUT_TOKENS=512          # Hard limit on response tokens per API call
ENABLE_PROMPT_CACHE=true        # Cache identical prompts to save 100% tokens

# Safety Rate Limits (client-side pacing to respect Gemini Free Tier limits)
MAX_CALLS_PER_MINUTE=15         # Keep at <= 15 to stay within Google Free Tier (15 RPM)
MAX_CALLS_PER_SESSION=200       # Stop execution if >200 requests made in one run
API_TIMEOUT_SECONDS=15.0        # Timeout per HTTP request

INDIAN_KANOON_API_KEY = your_indian_kanoon_api_key_here

